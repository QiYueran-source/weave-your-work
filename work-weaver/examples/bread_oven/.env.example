# One round of the bread machine. Copy to `.env` and fill in what you use.
#
# fast-agent reads `.env` from the directory the round is started in, which is
# `work-weaver/` when you use ./run_bread_oven.sh. A copy here works too if you
# start main.py from this directory.
#
# Nothing here is required when the model is a local Ollama: fast-agent's
# `generic` provider defaults to http://localhost:11434/v1.
# Real values belong in `.env`, which Git ignores. Never commit a key.

# ── the model ───────────────────────────────────────────────────────────────

# Which model every node uses. A provider-qualified fast-agent model string.
#   generic.<name>   any OpenAI-compatible endpoint (set the two lines below)
#   deepseek         DeepSeek's native route
#   gpt-5-mini       OpenAI
#   llama            a local llama.cpp server
BREAD_MODEL=generic.gpt-4.1

# Where that OpenAI-compatible endpoint answers, and the key it expects.
GENERIC_BASE_URL=http://localhost:11434/v1
GENERIC_API_KEY=ollama

# ── the round ───────────────────────────────────────────────────────────────

# Most grill exchanges in one round. The loop stops at this count whatever the
# grill says, and the last draft bakes.
BREAD_GRILL_ROUNDS=3

# The seed each bake's taste is drawn from. The same seed and round number
# score a rerun of that round the same way.
BREAD_SEED=7

# ── where things are written ────────────────────────────────────────────────

# Relative paths resolve against the directory the round starts in.
BREAD_RECORDS=runs
BREAD_LOGS=logs
BREAD_HANDBOOKS=handbooks

# Show the agents' conversation while the round runs.
# BREAD_VERBOSE=1
