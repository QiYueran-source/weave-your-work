# ── secrets ─────────────────────────────────────────────────────────────────

# A filled-in copy of .env.example. It holds the endpoint and its key.
.env
.env.*
!.env.example

# ── a local interpreter ─────────────────────────────────────────────────────

.venv/

# ── what a round writes ─────────────────────────────────────────────────────

# One directory per round: testimony, spec, tickets, round.json, trace.json.
runs/

# The run's own log, kept for reading after the fact. The folder stays.
logs/*
!logs/.gitkeep

# The handbook the chain rewrites. The person's base.md is source and stays.
handbooks/evolving.md

# ── what the tools leave behind ─────────────────────────────────────────────

__pycache__/
*.pyc

# fast-agent's own session store and log, if a run creates one here.
.fast-agent/

# pytest's cache and the last coverage report.
.pytest_cache/
.coverage
htmlcov/
