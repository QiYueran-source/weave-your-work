# ── secrets ─────────────────────────────────────────────────────────────────

# A filled-in copy of .env.example. It holds the endpoint and its key.
.env
.env.*
!.env.example

# ── a local interpreter ─────────────────────────────────────────────────────

.venv/

# ── what a round writes ─────────────────────────────────────────────────────

# One directory per experiment: exp1, exp2, and so on. Each holds that run's
# rounds, its results, its logs, and the two handbooks.
runs/

# ── what the tools leave behind ─────────────────────────────────────────────

__pycache__/
*.pyc

# fast-agent's own session store and log, if a run creates one here.
.fast-agent/

# pytest's cache and the last coverage report.
.pytest_cache/
.coverage
htmlcov/
