# A local interpreter.
.venv/

# fast-agent's own session store and log, written where a round starts.
.fast-agent/

# A filled-in copy of examples/bread_oven/.env.example: the endpoint and its
# key. The round starts here, so this is where fast-agent reads it from.
.env
.env.*
!.env.example

# What a round writes when it is started from this directory rather than from
# the example's own. These are run output, never source: the round resolves
# them beside the example, but an older run may have left copies here.
runs/
handbooks/
logs/*.jsonl
logs/*.md
logs/*.trace.json

# pytest's cache.
.pytest_cache/

# Python bytecode.
__pycache__/
*.pyc
