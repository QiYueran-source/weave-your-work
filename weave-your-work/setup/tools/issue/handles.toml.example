# The project roster.
#
# Copy this file to .work-weave/shared/handles.toml in the project root and
# replace the placeholder below with this project's owners and their GitHub
# logins. The file is committed; everything under .work-weave/personal/ is not.
[handles]
owner = "<github-login>"

# The listener writes the pending queue here. The path is relative to the
# project root.
[pending]
path = ".work-weave/personal/communication/pending.jsonl"
